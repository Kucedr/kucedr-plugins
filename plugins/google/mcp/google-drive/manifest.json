{
	"id": "google-drive",
	"name": "Google Drive",
	"description": "Search, organize, and manage your files in Google Drive.",
	"authentication": "oauth2",
	"url": "https://drivemcp.googleapis.com/mcp/v1",
	"scopes": [
		"https://www.googleapis.com/auth/drive.readonly",
		"https://www.googleapis.com/auth/drive.file"
	],
	"oauth": {
		"client_id_setting": "client_id",
		"client_secret_setting": "client_secret",
		"authorization_params": {
			"access_type": "offline",
			"prompt": "consent select_account"
		},
		"google_fetch": true
	},
	"icon_dark_url": "/assets/google-drive.svg",
	"icon_light_url": "/assets/google-drive.svg"
}
