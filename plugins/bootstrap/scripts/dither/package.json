{
	"name": "@kucedr-plugins/bootstrap-dither",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"description": "Bootstrap plugin script that renders dithercn dithers as self-contained HTML.",
	"scripts": {
		"build": "esbuild src/browser.jsx --bundle --minify --jsx=automatic --format=iife --outfile=dist/browser.js && esbuild src/index.mjs --bundle --platform=node --format=esm --outfile=dist/index.mjs",
		"dev": "npm run build && vite --config example/vite.config.mjs"
	},
	"devDependencies": {
		"@vitejs/plugin-react": "^6.1.2",
		"esbuild": "^0.28.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"vite": "^8.3.5"
	}
}
